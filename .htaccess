# ============================================================
# Ghazwan Portfolio — Apache delivery optimizations (cPanel)
# Safe alongside Passenger/Node.js: no routing rewrites enabled.
# ============================================================

# ---- Long-lived caching for immutable static assets ----
# Uploads use hashed filenames, so they never change content.
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|avif|jpg|jpeg|png|gif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ---- Text compression ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# ---- Optional: serve /uploads directly via Apache, bypassing Passenger ----
# Enable ONLY AFTER verifying your vhost layout. Test with:
#   curl -I https://<domain>/uploads/<file>.webp
# Expect: 200 OK, Content-Type image/webp, Cache-Control immutable,
# and NO X-Powered-By header (which indicates the Node process answered).
#
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteRule ^uploads/(.+)$ public/uploads/$1 [L]
# </IfModule>
